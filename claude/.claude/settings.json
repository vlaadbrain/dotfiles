  "editorMode": "vim",
  "hooks": {"SessionStart":[{"matcher":"^(startup|resume|clear|compact|fork)$","hooks":[{"type":"command","command":"bash '/home/cjt/.claude/hooks/herdr-agent-state.sh' session","timeout":10}]}]}
